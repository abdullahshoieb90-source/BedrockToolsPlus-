{
  "namespace": "chat_animation",
  "msg_out_animation": {
    "anim_type": "size",
    "easing": "out_cubic",
    "duration": 0.5,
    "to": [0, "100%-50px"],
    "from": ["100%-2px", "100%-50px"],
    "play_event": "screen.exit_push",
    "reset_event": "screen_animation_reset"
  },

  "msg_out_animation_pop": {
    "anim_type": "size",
    "easing": "out_cubic",
    "duration": 0.5,
    "to": [0, "100%-50px"],
    "from": ["100%-2px", "100%-50px"],
    "play_event": "screen.exit_pop",
    "reset_event": "screen_animation_reset"
  },

  "msg_enter_animation": {
    "anim_type": "size",
    "easing": "out_cubic",
    "duration": 0.5,
    "from": [0, "100%-50px"],
    "to": ["100%-2px", "100%-50px"],
    "play_event": "screen.entrance_push",
    "resettable": true
  },

  "msg_enter_animation_pop": {
    "anim_type": "size",
    "easing": "out_cubic",
    "duration": 0.5,
    "from": [0, "100%-50px"],
    "to": ["100%-2px", "100%-50px"],
    "play_event": "screen.entrance_pop",
    "resettable": true
  },

  "bot_pane_out_animation": {
    "anim_type": "offset",
    "easing": "out_cubic",
    "duration": 0.5,
    "from": [ 0, 0 ],
    "to": [ 0, "20%" ],
    "play_event": "screen.exit_push",
    "reset_event": "screen_animation_reset"
  },

  "bot_pane_out_animation_pop": {
    "anim_type": "offset",
    "easing": "out_cubic",
    "duration": 0.5,
    "from": [ 0, 0 ],
    "to": [ 0, "20%" ],
    "play_event": "screen.exit_pop",
    "reset_event": "screen_animation_reset"
  },

  "bot_pane_enter_animation": {
    "anim_type": "offset",
    "easing": "out_cubic",
    "duration": 0.5,
    "from": [ 0, "20%" ],
    "to": [ 0, 0 ],
    "play_event": "screen.entrance_push",
    "resettable": true
  },

  "bot_pane_enter_animation_pop": {
    "anim_type": "offset",
    "easing": "out_cubic",
    "duration": 0.5,
    "from": [ 0, "20%" ],
    "to": [ 0, 0 ],
    "play_event": "screen.entrance_pop",
    "resettable": true
  }
}