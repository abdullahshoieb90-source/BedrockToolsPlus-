  "num_base": {
    "type": "panel",
    "size": [14, 14],
    "controls": [
      {
        "text": {
          "type": "label",
          "size": ["default", "default"],
          "text": "$text",
          "color": [0.7, 0.7, 0.7],
          "font_scale_factor": 0.6,
          "alpha": 0.9,
          "font_type": "$global_font_type",
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [0.5, -0.25],
          "layer": 24
