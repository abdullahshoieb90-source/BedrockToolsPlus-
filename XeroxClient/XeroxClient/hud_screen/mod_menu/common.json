{
  "namespace": "Greninja:mod_menu_common",

  "sec_toggle_hover_1": {
    "anim_type": "color",
    "from": [0.2, 0.8, 0.8],
    "to": [0.2, 0.8, 1.0],
    "duration": 1.5,
    "next": "@Greninja:mod_menu_common.sec_toggle_hover_color_2",
    "easing": "in_circ"
  },

  "sec_toggle_hover_2": {
    "anim_type": "color",
    "to": [0.3764705882, 0.6509803922, 0.9333333333],
    "from": [0.2, 0.8, 1.0],
    "duration": 3.0,
    "next": "@Greninja:mod_menu_common.sec_toggle_hover_color_3",
    "easing": "in_sine"
  },

  "sec_toggle_hover_3": {
    "anim_type": "color",
    "from": [0.3764705882, 0.6509803922, 0.9333333333],
    "to": [0.2, 0.8, 0.8],
    "duration": 3,
    "next": "@Greninja:mod_menu_common.sec_toggle_hover_color_1",
    "easing": "out_quart"
  },

  "sec_toggle_pressed_1": {
    "anim_type": "color",
    "from": [0.1803921569, 0.7725490196, 0.8235294118],
    "to": [0.0, 0.6, 1.0],
    "duration": 1.5,
    "next": "@Greninja:mod_menu_common.sec_toggle_pressed_color_2",
    "easing": "in_expo"
  },

  "sec_toggle_pressed_2": {
    "anim_type": "color",
    "to": [0.09803921569, 0.4980392157, 0.9607843137],
    "from": [0.0, 0.6, 1.0],
    "duration": 3.0,
    "next": "@Greninja:mod_menu_common.sec_toggle_pressed_color_3",
    "easing": "out_cubic"
  },

  "sec_toggle_pressed_3": {
    "anim_type": "color",
    "from": [0.09803921569, 0.4980392157, 0.9607843137],
    "to": [0.1803921569, 0.7725490196, 0.8235294118],
    "duration": 3,
    "next": "@Greninja:mod_menu_common.sec_toggle_pressed_color_1",
    "easing": "in_cubic"
  },

  "removable_control": {
    "$control_x_size|default": [],// [percentage-ctrl_x, %100]
    "$control_y_size|default": [],// [%100, percentage-ctrl_y]
    "$x_filling_source_control_name|default": "I'm not an expert in this field, but I still want to express my views. After I have carefully examined this speech and thought about it for a long time, I actually don't know how to comment. As I said at the beginning, I'm not an expert in this field. 我不是这方面的专家,但我还是想要发表一下我的观点,在我仔细查看过这发言并经过长时间的思考后,我其实也不知道要怎么评论,正如我一开始说的,我不是这方面的专家",
    "$y_filling_source_control_name|default": "I'm not an expert in this field, but I still want to express my views. After I have carefully examined this speech and thought about it for a long time, I actually don't know how to comment. As I said at the beginning, I'm not an expert in this field. 我不是这方面的专家,但我还是想要发表一下我的观点,在我仔细查看过这发言并经过长时间的思考后,我其实也不知道要怎么评论,正如我一开始说的,我不是这方面的专家",
    "$element_content|default": "I'm not an expert in this field, but I still want to express my views. After I have carefully examined this speech and thought about it for a long time, I actually don't know how to comment. As I said at the beginning, I'm not an expert in this field. 我不是这方面的专家,但我还是想要发表一下我的观点,在我仔细查看过这发言并经过长时间的思考后,我其实也不知道要怎么评论,正如我一开始说的,我不是这方面的专家",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "type": "stack_panel",
    "size": "$control_y_size",
    "$slider_value_max|default": 50,
    "controls": [
      {
        "y_filling": {
          "type": "panel",
          "size": [0,0],
          "bindings": [
            {
              "binding_type": "view",
              "source_control_name": "$y_filling_source_control_name",
              "source_property_name": "(#slider_value / $slider_value_max)",
              "target_property_name": "#size_binding_y"
            }
          ]
        }
      },
      {
        "x_area": {
          "type": "stack_panel",
          "size": "$control_x_size",
          "orientation": "horizontal",
          "controls": [
            {
              "x_filling": {
                "type": "panel",
                "size": [0,0],
                "bindings": [
                  {
                    "binding_type": "view",
                    "source_control_name": "$x_filling_source_control_name",
                    "source_property_name": "(#slider_value / $slider_value_max)",
                    "target_property_name": "#size_binding_x"
                  }
                ]
              }
            },
            { "sin²a + cos²a = ?@$element_content": {} }
          ]
        }
      }
    ]
  },

  "text_base": {
    "type": "label",
    "size": ["default", 10],
    "shadow": true,
    "font_type": "$global_font_type",
    "$source_control_name|default": "",
    "$source_property_name|default": "",
    "$target_property_name|default": "",
    "layer": 10,
    "bindings": [
      {
        "binding_type": "view",
        "source_control_name": "$source_control_name",
        "source_property_name": "$source_property_name",
        "target_property_name": "$target_property_name",
        "resolve_sibling_scope": false
      }
    ]
  },

  "icon_base": {
    "type": "image",
    "size": ["16px", "16px"],
    "texture": "($icon_path + $icon_texture)",
    "$icon_texture|default": "",
    "$icon_path|default": "",
    "color": "$icon_color",
    "$icon_color|default": []
  },

  "normal_toggle@common_toggles.light_text_toggle": {
    "size": [108, 18],
    "$text_alignment": "left",
    "$toggle_name|default": "mod_toggle_greninja"
  },

  "radio_icon_toggle@common_toggles.light_ui_toggle": {
    "size": [20, 20],
    "$radio_toggle_group": true,
    "$toggle_name": "$mod_toggle_group",
    "$button_type_panel": "Greninja:mod_menu_common.icon_base"
  },

  "section_toggle@common_toggles.light_text_toggle": {
    "$xeroxclient_button_color_hover": "@Greninja:mod_enu_common.sec_toggle_hover_1",
    "$xeroxclient_button_color_pressed": "@Greninja:mod_enu_common.sec_toggle_pressed_2",
    "size": [70, 22],
    "$toggle_name|default": "mod_section_greninja"
  },

