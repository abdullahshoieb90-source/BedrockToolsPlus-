{
  "namespace": "Greninja:mod_menu_section",

  "base_stack_panel": {
    "size": [110, "100%c"],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "bindings": [
      {
        "binding_type": "view",
        "source_control_name": "$source_control_name",
        "source_property_name": "#toggle_state",
        "target_property_name": "#visible"
      }
    ],
    "type": "stack_panel"
  },

  "game_play@Greninja:mod_menu_section.base_stack_panel": {
    "$source_control_name": "game_play_section",
    "controls": [
      {
        "title_text": {
          "type": "label",
          "size": ["100%", "default"],
          "text": "modmenu.sec.gameplay",
          "font_scale_factor": 1.35,
          "font_type": "$global_font_type",
          "shadow": true
        }
      },
      {
        "title@Greninja:mod_menu_common.normal_toggle": {
          "$button_text": "mod.title",
          "$toggle_default_state": "$title_enabled",
          "$toggle_view_binding_name": "mod_title"
        }
      },
      {
        "chat@Greninja:mod_menu_common.normal_toggle": {
          "$button_text": "mod.chat",
          "$toggle_default_state": "$chat_enabled",
          "$toggle_view_binding_name": "mod_chat"
        }
      },
      {
        "actionbar@Greninja:mod_menu_common.normal_toggle": {
          "$button_text": "mod.actionbar",
          "$toggle_default_state": "$actionbar_enabled",
          "$toggle_view_binding_name": "mod_actionbar"
        }
      },
      {
        "scoreboard@Greninja:mod_menu_common.normal_toggle": {
          "$button_text": "mod.scoreboard",
          "$toggle_default_state": "$scoreboard_enabled",
          "$toggle_view_binding_name": "mod_scoreboard"
        }
      },
      {
        "itemname@Greninja:mod_menu_common.normal_toggle": {
          "$button_text": "mod.itemname",
          "$toggle_default_state": "$itemname_enabled",
          "$toggle_view_binding_name": "mod_itemname"
        }
      },
      {
        "tip@Greninja:mod_menu_common.normal_toggle": {
          "$button_text": "mod.tip",
          "$toggle_default_state": "$tip_enabled",
          "$toggle_view_binding_name": "mod_tip"
        }
      },
      {
        "bossbar@Greninja:mod_menu_common.normal_toggle": {
          "$button_text": "mod.bossbar",
          "$toggle_default_state": "$bossbar_enabled",
          "$toggle_view_binding_name": "mod_bossbar"
        }
      }
    ]
  },

