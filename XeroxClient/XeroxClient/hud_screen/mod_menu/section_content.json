  "backgrounds@Greninja:mod_menu_section.base_stack_panel": {
    "$source_control_name": "backgrounds_section",
    "$mod_toggle_group": "mod_backgrounds",
    "controls": [
      {
        "title_text": {
          "type": "label",
          "size": ["100%", "default"],
          "text": "modmenu.sec.backgrounds",
          "font_scale_factor": 1.35,
          "font_type": "$global_font_type",
          "shadow": true
        }
      },
      {
        "bg_enabled@Greninja:mod_menu_common.normal_toggle": {
          "$button_text": "mod.toggle.enabled",
          "$toggle_default_state": "$background_enabled",
          "$toggle_view_binding_name": "mod_background"
        }
      },
      {
        "toggle_and_slider": {
          "type": "stack_panel",
          "size": ["100%", "100%c"],
          "bindings": [
            {
              "binding_type": "view",
              "source_control_name": "mod_background",
              "source_property_name": "#toggle_state",
              "target_property_name": "#enabled"
            }
          ],
          "controls": [
            {
              "mod_backgrounds_alpha_slider@Greninja:mod_menu_common.slider": {
                "$source_control_name": "mod_backgrounds_alpha_slider",
                "$slider_value_expression": "((#slider_value + $background_alpha)*10)",
                "$value_0_text": "Opacity: 0%%",
                "$value_1_text": "Opacity: 10%%",
                "$value_2_text": "Opacity: 20%%",
                "$value_3_text": "Opacity: 30%%",
                "$value_4_text": "Opacity: 40%%",
                "$value_5_text": "Opacity: 50%%",
                "$value_6_text": "Opacity: 60%%",
                "$value_7_text": "Opacity: 70%%",
                "$value_8_text": "Opacity: 80%%",
                "property_bag": {
                  "#slider_steps": 9
                }
              }
            },
            {
              "lighter@Greninja:mod_menu_common.normal_toggle": {
                "$button_text": "mod.bg.lighter",
                "$radio_toggle_group": true,
                "$toggle_name": "$mod_toggle_group",
                "$toggle_group_default_selected": "$background_type",
                "$toggle_view_binding_name": "mod_backgrounds_lighter",
                "$toggle_group_forced_index": 0
              }
            },
            {
              "darker@Greninja:mod_menu_common.normal_toggle": {
                "$button_text": "mod.bg.darker",
                "$radio_toggle_group": true,
                "$toggle_name": "$mod_toggle_group",
                "$toggle_group_default_selected": "$background_type",
                "$toggle_view_binding_name": "mod_backgrounds_darker",
                "$toggle_group_forced_index": 10
              }
            },
            {
              "scrolling_panel@common.scrolling_panel": {
                "size": [108, 55],
                "$scrolling_content": "Greninja:mod_menu_section.backgrounds_scrolling_content"
              }
            }
          ]
        }
      }
    ]
  },

