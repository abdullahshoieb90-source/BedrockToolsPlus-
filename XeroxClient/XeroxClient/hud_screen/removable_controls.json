    "$y_filling_source_control_name": "mod:inv_hud_y_offset",
    "$element_content": "inventory_hud_type.vertical_type",
    "bindings": [
      {
        "binding_type": "view",
        "source_control_name": "mod_verinvhud",
        "source_property_name": "#toggle_state",
        "target_property_name": "#visible"
      }
