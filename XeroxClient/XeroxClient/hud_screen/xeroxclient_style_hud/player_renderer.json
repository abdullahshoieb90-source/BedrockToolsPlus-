{
  "namespace": "xeroxclient_style_paperdoll",
  "hud_player_renderer": {
    "type": "custom",
    "renderer": "($paper_doll_type + '_' + 'p' + 'l' + 'a' + 'y' + 'e' + 'r' + '_' + 'r' + 'e' + 'n' + 'd' + 'e' + 'r' + 'e' + 'r')",
    "size": [ 60, 60 ],
    "offset": [30, -15],
    "anchor_from": "bottom_left",
    "anchor_to": "bottom_left",
    "bindings": [
      {
        "binding_name": "#paper_doll_visible",
        "binding_name_override": "#visible"
      }
    ]
  }
}