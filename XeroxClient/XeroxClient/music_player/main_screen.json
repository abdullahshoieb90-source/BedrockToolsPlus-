{
  "namespace": "music_player_main_screen",
  "scrolling_panel@common.scrolling_panel": {
    "size": ["70%", "100% - 53px"],
    "anchor_from": "bottom_middle",
    "anchor_to": "bottom_middle",
    "$show_background": false,
    "$scroll_size": [ 5, "100% - 4px" ],
    "$scrolling_pane_size": [ "100% - 4px", "100%" ],
    "$scrolling_pane_offset": [ 2, 0 ],
    "$scroll_bar_right_padding_size": [ 0, 0 ]
  },

  "section_toggle@settings_common.section_toggle_base": {
    "size": ["50%", "30px"],
    "$glyph_size": [16, 16]
  },

  "section_toggle_stack": {
    "type": "stack_panel",
    "size": ["70%", "30px"],
    "orientation": "horizontal",
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "offset": [0, "23px"],
    "$default_selector_toggle_index": 0,
    "controls": [
      {
        "minecraft_music_section@music_player_main_screen.section_toggle": {
          "$toggle_view_binding_name": "minecraft_music_toggle",
          "$icon_name": "minecraft",
          "$toggle_group_forced_index": 0,
          "$button_text": "Minecraft Music"
        }
      },
      {
        "custom_music_section@music_player_main_screen.section_toggle": {
          "$toggle_view_binding_name": "custom_music_toggle",
          "$icon_name": "custom",
          "$toggle_group_forced_index": 1,
          "$button_text": "Custom Music"
        }
      }
    ]
  },

  "main_screen_content": {
    "type": "panel",
    "controls": [
      { "bg@Xerox_common.background": { "ignored": "(not $is_pregame)" } },
      { "header@Xerox_common.common_header": { "$white_bg": false, "$header_text": "music player" } },
      { "section_toggle_stack@music_player_main_screen.section_toggle_stack": {} },
      {
        "scrolling_panel_1@music_player_main_screen.scrolling_panel": {
          "$scrolling_content": "music_player_main_screen.button_stack_1"
        }
      },
      {
        "scrolling_panel_2@music_player_main_screen.scrolling_panel": {
          "$scrolling_content": "music_player_main_screen.button_stack_2"
        }
      }
    ]
  },

