{
  "namespace": "pause_player_list",

  "player_lists": {
    "type": "panel",
    "size": [ "100%", "100%c" ],
    "controls": [
      {
        "player_list@pause_player_list.player_list": {
          "bindings": [
            {
              "binding_name": "(not #list_has_display_objective)",
              "binding_name_override": "#visible"
            }
          ]
        }
      },
      {
        "scoreboard_list@scoreboard.scoreboard_player_list": {
          "bindings": [
            {
              "binding_name": "#list_has_display_objective",
              "binding_name_override": "#visible"
            }
          ]
        }
      }
    ]
  },

  "player_list": {
    "type": "stack_panel",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "size": [ "100%", "100%c" ],
    "focus_container": true,
    "use_last_focus": true,
    "focus_navigation_mode_right": "contained",
    "controls": [
      {
        "vertical_padding@pause.vertical_padding": {
          "size": [ 0, 3 ],
          "ignored": "$education_edition"
        }
      },
      { "players_grid_panel@pause_player_list.players_grid": {} },
      {
        "vertical_padding_1@pause.vertical_padding": {
          "size": [ 0, 3 ]
        }
      }
    ]
  },

  "player_list_scrolling_panel@common.scrolling_panel": {
    "size": [ 200, 90 ],
    "offset": [ 0, 50 ],
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "$show_background": false,
    "$scroll_track_size": [ 5, "100% - 4px" ],
    "$scroll_track_offset|default": [ -4, 2 ],
    "$scrolling_content": "pause_player_list.player_lists"
  },

  "player_list_panel_content": {
    "type": "stack_panel",
    "size": [200, "100%c"],
    "controls": [
      {
        "title_panel": {
          "type": "image",
          "size": ["100%", 25],
          "texture": "textures/ui/Xerox/Black",
          "alpha": 0.2,
          "clips_children": true,
          "controls": [
            {
              "title_text": {
                "type": "label",
                "size": ["100%", 20],
                "text": "Player List",
                "offset": [0, -2],
                "font_scale_factor": 2,
                "font_type": "KaushanScript-Regular",
                "text_alignment": "center",
                "layer": 10
              }
            },
            {
              "top_line": {
                "type": "image",
                "size": ["100%", 1],
                "texture": "textures/ui/Xerox/White",
                "anchor_from": "top_middle",
                "anchor_to": "top_middle",
                "layer": 10
              }
            },
            {
              "bottom_line": {
                "type": "image",
                "size": ["100%", 1],
                "texture": "textures/ui/Xerox/White",
                "anchor_from": "bottom_middle",
                "anchor_to": "bottom_middle",
                "layer": 10
              }
            },
            {
              "background": {
                "type": "image",
                "size": ["100%", "400%"],
                "texture": "textures/ui/Xerox/image/BlackToTransparent1",
                "anchor_from": "bottom_middle",
                "anchor_to": "top_middle",
                "layer": -10,
                "offset": [0, 2],
                "alpha": 0.8
              }
            }
          ],
          "animation_reset_name": "screen_animation_reset",
          "anims": [
            "@pause_animation.title_out_animation",
            "@pause_animation.title_out_animation_pop",
            "@pause_animation.title_enter_animation",
            "@pause_animation.title_enter_animation_pop"
          ]
        }
      },
      {
        "padding": {
          "type": "panel",
          "size": [0, 2]
        }
      },
      {
        "players_label@pause_player_list.players_label": {
          "ignored": "$education_edition",
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "offset": [0, 54]
        }
      },
      { "player_list_scrolling_panel@pause_player_list.player_list_scrolling_panel": { "offset": [0, 64] } },
      {
        "invite_players@pause_main_menu.invite_players": {
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "offset": [0, 153]
        }
      }
    ],
    "bindings": [
      {
        "binding_type": "view",
        "source_control_name": "player_list",
        "source_property_name": "#toggle_state",
        "target_property_name": "#visible"
      }
    ]
  },

  "players_label": {
    "type": "label",
    "text": "#worldname",
    "size": [ "100%", 10 ],
    "text_alignment": "center",
    "font_type": "$global_font_type",
    "layer": 2,
    "bindings": [
      {
        "binding_name": "#worldname"
      }
    ]
  },

  "players_grid": {
    "type": "grid",
    "size": [ "100%", "default" ],
    "grid_item_template": "pause_player_list.player_grid_item",
    "grid_dimension_binding": "#players_grid_dimension",
    "collection_name": "players_collection",
    "anchor_to": "top_left",
    "anchor_from": "top_left",
    "bindings": [
      {
        "binding_name": "#players_grid_dimension",
        "binding_condition": "always"
      }
    ]
  },

  "player_grid_item": {
    "type": "stack_panel",
    "orientation": "horizontal",
    "size": [ "100%", 20 ],
    "controls": [
      {
        "player_button_panel": {
          "type": "stack_panel",
          "orientation": "horizontal",
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "size": [ "100%", "100%" ],
          "controls": [
            {
              "player_button_banner": {
                "type": "panel",
                "size": [ "fill", "100%" ],
                "controls": [
                  {
                    "player_button@common_buttons.dark_content_button": {
                      "size": [ "100%", "100%" ],
                      "anchor_from": "top_left",
                      "anchor_to": "top_left",
                      "$button_content": "pause_player_list.player_button_content",
                      "button_mappings": [
                        {
                          "from_button_id": "button.menu_select",
                          "to_button_id": "button.player_profile_card",
                          "mapping_type": "pressed"
                        },
                        {
                          "from_button_id": "button.menu_ok",
                          "to_button_id": "button.player_profile_card",
                          "mapping_type": "focused"
                        }
                      ],
                      "bindings": [
                        {
                          "binding_name": "#button_enabled",
                          "binding_type": "collection",
                          "binding_collection_name": "players_collection",
                          "binding_name_override": "#visible"
                        },
                        {
                          "binding_type": "collection_details",
                          "binding_collection_name": "players_collection"
                        }
                      ]
                    }
                  },
                  {
                    "player_banner": {
                      "type": "panel",
                      "size": [ "100%", "100%" ],
                      "anchor_from": "top_left",
                      "anchor_to": "top_left",
                      "controls": [
                        {
                          "player_grid_banner_no_focus@pause.player_grid_banner_no_focus": {
                            "texture": "textures/ui/Xerox/Black",
                            "alpha": 0.6,
                            "controls": [
                              {
                                "player_button_content@pause_player_list.player_button_content": {
                                  "offset": [ 7, 0 ],
                                  "size": [ "92%", "90%" ]
                                }
                              }
                            ]
                          }
                        },
                        {
                          "focus_border_button@pause.focus_border_button": {
                            "tts_inherit_siblings": true,
                            "layer": 5
                          }
                        }
                      ],
                      "bindings": [
                        {
                          "binding_name": "#button_disabled",
                          "binding_type": "collection",
                          "binding_collection_name": "players_collection",
                          "binding_name_override": "#visible"
                        }
                      ]
                    }
                  }
                ]
              }
            },
            {
              "player_permission_button_padding": {
                "type": "panel",
                "size": [ 2, "100%" ],
                "bindings": [
                  {
                    "binding_name": "#permissions_button_visible",
                    "binding_name_override": "#visible"
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "player_permission_button_panel": {
          "type": "panel",
          "anchor_to": "top_right",
          "anchor_from": "top_right",
          "size": [ "100%c", "100%" ],
          "controls": [
            { "player_permission_button@pause_player_list.player_permission_button": { "offset": [0, -1] } }
          ],
          "bindings": [
            {
              "binding_name": "#permissions_button_visible",
              "binding_name_override": "#visible"
            }
          ]
        }
      }
    ]
  },

  "player_permission_button@common_buttons.dark_content_button": {
    "size": [ 20, "100%" ],
    "$button_content": "pause_player_list.player_permission_button_content",
    "$button_tts_header": "accessibility.pause.permissions",
    "button_mappings": [
      {
        "from_button_id": "button.menu_select",
        "to_button_id": "button.menu_permission",
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.menu_ok",
        "to_button_id": "button.menu_permission",
        "mapping_type": "focused"
      }
    ],
    "bindings": [
      {
        "binding_type": "collection_details",
        "binding_collection_name": "players_collection"
      }
    ]
  },

  "player_permission_button_content": {
    "type": "panel",
    "size": [ 15, 15 ],
    "controls": [
      {
        "permission_icon_image": {
          "type": "image",
          "texture": "#player_permission_level_icon_texture",
          "size": [ 15, 15 ],
          "bindings": [
            {
              "binding_name": "#player_permission_level_icon_texture",
              "binding_name_override": "#texture",
              "binding_type": "collection",
              "binding_collection_name": "players_collection"
            }
          ]
        }
      }
    ]
  },

  "player_button_content": {
    "type": "stack_panel",
    "orientation": "horizontal",
    "anchor_from": "left_middle",
    "anchor_to": "left_middle",
    "size": [ "100%-1px", "100%-1px" ],
    "layer": 3,
    "controls": [
      {
        "player_pic_panel@pause_player_list.player_pic_panel": {
          "layer": 1
        }
      },
      {
        "player_gamertag@pause_player_list.gametag_wrapper": {
          "size": [ "fill", "100%" ],
          "layer": 1
        }
      },
      {
        "platform_icon@pause_player_list.platform_icon_panel": {
          "layer": 1
        }
      }
    ]
  },

  "player_pic_panel": {
    "type": "panel",
    "size": [ 15, "100%" ],
    "anchor_to": "left_middle",
    "anchor_from": "left_middle",
    "ignored": "$education_edition",
    "controls": [
      { "player_gamer_pic@pause_player_list.player_gamer_pic": {} },
      { "player_local_icon@pause_player_list.player_local_icon": {} }
    ]
  },

  "player_local_icon": {
    "type": "image",
    "texture": "textures/ui/lan_icon",
    "size": [ 13, 13 ],
    "layer": 1,
    "bindings": [
      {
        "binding_name": "#local_icon_visible",
        "binding_type": "collection",
        "binding_collection_name": "players_collection",
        "binding_name_override": "#visible"
      }
    ]
  },

  "player_gamer_pic": {
    "type": "image",
    "texture": "#texture",
    "size": [ 15, 15 ],
    "layer": 1,
    "texture_file_system": "#texture_source",
    "anchor_from": "left_middle",
    "anchor_to": "left_middle",
    "bindings": [
      {
        "binding_name": "#texture",
        "binding_type": "collection",
        "binding_collection_name": "players_collection"
      },
      {
        "binding_name": "#texture_source",
        "binding_name_override": "#texture_file_system",
        "binding_type": "collection",
        "binding_collection_name": "players_collection"
      },
      {
        "binding_name": "#gamerpic_visible",
        "binding_type": "collection",
        "binding_collection_name": "players_collection",
        "binding_name_override": "#visible"
      }
    ]
  },

  "gametag_wrapper": {
    "type": "panel",
    "size": [ "100%c", "100%" ],
    "anchor_from": "left_middle",
    "anchor_to": "left_middle",
    "controls": [
      {
        "gamertag@pause_player_list.player_gamertag": {}
      }
    ]
  },

  "platform_icon_panel": {
    "type": "panel",
    "$icon_panel_size|default": [ "100%c + 4px", "100%" ],
    "size": "$icon_panel_size",
    "controls": [
      {
        "platform_icon@pause_player_list.platform_icon": {
          "layer": 1,
          "anchor_from": "left_middle",
          "anchor_to": "left_middle",
          "size": [ 15, 15 ]
        }
      }
    ]
  },

  "player_gamertag": {
    "type": "label",
    "text": "#gamertag",
    "font_type": "$global_font_type",
    "anchor_from": "left_middle",
    "anchor_to": "left_middle",
    "size": [ "100%", 10 ],
    "layer": 2,
    "offset": [2, 0],
    "bindings": [
      {
        "binding_name": "#gamertag",
        "binding_type": "collection",
        "binding_collection_name": "players_collection"
      }
    ]
  },

  "platform_icon": {
    "ignored": "(not $platform_icons_visible)",
    "type": "image",
    "texture": "textures/ui/platform_icon",
    "bindings": [
      {
        "binding_name": "#is_platform_icon_visible",
        "binding_type": "collection",
        "binding_collection_name": "players_collection",
        "binding_name_override": "#visible"
      }
    ]
  }
}