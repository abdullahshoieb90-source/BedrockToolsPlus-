    "anim_type": "offset",
    "easing": "out_cubic",
    "duration": 0.6,
    "from": [ 0, "100% - 22px" ],
    "to": [ 0, "100%" ],
    "play_event": "screen.exit_push",
    "reset_event": "screen_animation_reset"
  },

