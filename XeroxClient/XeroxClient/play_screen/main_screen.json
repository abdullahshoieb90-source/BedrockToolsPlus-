{
  "namespace": "play_main_screen",
  "play_header@Xerox_common.common_header": {
    "anchor_to": "top_left",
    "anchor_from": "top_left",
    "$header_text|default": "play"
  },
  "main_screen_panel": {
    "type": "panel",
    "controls": [
      { "main_screen@main_screen": {} },
      {
        "popup_dialog_factory": {
          "type": "factory",
          "layer": 12,
          "control_ids": {
            "join_by_code": "@play.popup_dialog_join_by_code",
            "high_ping_warning": "@play.popup_dialog_high_ping"
          }
        }
      },
      {
        "background@xc_common.background": {
          "animation_reset_name": "screen_animation_reset",
          "anims": [
            "@play_animation.background_out_animation",
            "@play_animation.background_out_animation_pop",
            "@play_animation.background_enter_animation",
            "@play_animation.background_enter_animation_pop"
          ]
        }
      },
      {
        "background_blur@xc_common.background_blur": {
          "animation_reset_name": "screen_animation_reset",
          "anims": [
            "@play_animation.background_out_animation",
            "@play_animation.background_blur_out_animation_pop",
            "@play_animation.background_blur_enter_animation",
            "@play_animation.background_enter_animation_pop"
          ],
          "layer": -11
        }
      }
    ]
  },
  "main_screen": {
    "type": "panel",
    "controls": [
      { "play_header@play_main_screen.play_header": {} },
      { "main_panel@play_main_screen.main_panel": {} },
      {
        "quick_button_panel": {
          "offset": [0, "100% - 22px"],
          "animation_reset_name": "screen_animation_reset",
          "anims": [
            "@play_animation.quick_button_out_animation",
            "@play_animation.quick_button_out_animation_pop",
            "@play_animation.quick_button_enter_animation",
            "@play_animation.quick_button_enter_animation_pop"
          ],
          "type": "panel",
          "clips_children": true,
          "controls": [
            {
              "background_blur_image": {
                "type": "image",
                "offset": [0, "-100% + 22px"],
                "fill": true,
                "layer": 1,
                "animation_reset_name": "screen_animation_reset",
                "anims": [
                  "@play_animation.quick_button_background_blur_out_animation",
                  "@play_animation.quick_button_background_blur_out_animation_pop",
                  "@play_animation.quick_button_background_blur_enter_animation",
                  "@play_animation.quick_button_background_blur_enter_animation_pop"
                ],
                "texture": "$background_blur_texture"
              }
            },
            {
              "background_image": {
                "type": "image",
                "texture": "textures/ui/Xerox/Black",
                "alpha": 0.15,
                "layer": 2
              }
            },
            { "quick_button@play_main_screen.quick_button": { "layer": 3 } }
          ]
        }
      }
    ]
  },
  "main_panel": {
    "type": "stack_panel",
    "size": ["100%", "100%"],
    "clips_children": true,
    "orientation": "vertical",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "controls": [
      {
        "padding0": {
          "type": "panel",
          "size": [0, 23]
        }
      },
      {
        "panel": {
          "type": "panel",
          "size": ["100%", "100% - 43px"],
          "layer": 2,
          "clips_children": true,
          "controls": [
            {
              "tab_stack": {
                "offset": [2, 0],
                "type": "stack_panel",
                "size": ["20% - 3px", "100%"],
                "anchor_from": "top_left",
                "anchor_to": "top_left",
                "orientation": "vertical",
                "animation_reset_name": "screen_animation_reset",
                "anims": [
                  "@play_animation.tab_button_out_animation",
                  "@play_animation.tab_button_out_animation_pop",
                  "@play_animation.tab_button_enter_animation",
                  "@play_animation.tab_button_enter_animation_pop"
                ],
                "controls": [
                  {
                    "padding1":{
                      "type": "panel",
                      "size": [0,3]
                    }
                  },
                  { "select_world_button@play_tab_common.world_nav_tab": {} },
                  {
                    "padding2":{
                      "type": "panel",
                      "size": [0,1]
                    }
                  },
                  { "select_friend_button@play_tab_common.friends_nav_tab": {} },
                  {
                    "padding3":{
                      "type": "panel",
                      "size": [0,1]
                    }
                  },
                  { "select_server_button@play_tab_common.server_nav_tab": {} }
                ]
              }
            },
            {
              "tab_content_panels": {
                "type": "panel",
                "anchor_from": "top_right",
                "anchor_to": "top_right",
                "size": ["80%", "100%"],
                "animation_reset_name": "screen_animation_reset",
                "anims": [
                  "@play_animation.tab_content_out_animation",
                  "@play_animation.tab_content_out_animation_pop",
                  "@play_animation.tab_content_enter_animation",
                  "@play_animation.tab_content_enter_animation_pop"
                ],
                "controls": [
                  {
                    "world_section_content@play.worlds_scroll_content": {
                      "anims": ["@play_animation.section_content_alpha"],
                      "animation_reset_name": "button.tab_anim",
                      "propagate_alpha": true,
                      "bindings": [
                        {
                          "binding_type": "view",
                          "source_control_name": "play_world_section",
                          "source_property_name": "#toggle_state",
                          "target_property_name": "#visible"
                        }
                      ],
                      "layer": 2
                    }
                  },
                  {
                    "friend_section_content@play.friends_scroll_content": {
                      "anims": ["@play_animation.section_content_alpha"],
                      "animation_reset_name": "button.tab_anim",
                      "propagate_alpha": true,
                      "bindings": [
                        {
                          "binding_type": "view",
                          "source_control_name": "play_friend_section",
                          "source_property_name": "#toggle_state",
                          "target_property_name": "#visible"
                        }
                      ],
                      "layer": 2
                    }
                  },
                  {
                    "server_section_content@play.common_content": {
                      "anims": ["@play_animation.section_content_alpha"],
                      "animation_reset_name": "button.tab_anim",
                      "propagate_alpha": true,
                      "controls": [
                        {
                          "section_toggle": {
                            "type": "stack_panel",
                            "size": ["100%-4px", 16],
                            "orientation": "horizontal",
                            "anchor_from": "top_left",
                            "anchor_to": "top_left",
                            "offset": [2, 2],
                            "controls": [
                              {
                                "featured@pause_main_menu.section_toggle_base": {
                                  "size": ["fill", 16],
                                  "$button_text": "Featured Servers",
                                  "$toggle_view_binding_name": "featured_servers",
                                  "$toggle_group_forced_index": 1
                                }
                              },
                              {
                                "additional@pause_main_menu.section_toggle_base": {
                                  "size": ["fill", 16],
                                  "$button_text": "Additional Servers",
                                  "$toggle_view_binding_name": "additional_servers",
                                  "$toggle_group_forced_index": 0,
                                  "$toggle_default_state": true
                                }
                              }
                            ]
                          }
                        },
                        {
                          "more_servers_divider@common.horizontal_divider": {
                            "$image_size": ["100%-5px", 1.5],
                            "anchor_from": "top_left",
                            "anchor_to": "top_left",
                            "offset": [0, 20]
                          }
                        },
                        {
                          "scrolling_panel@play.scrolling_offsets": {
                            "size": ["100%-4px", "100%-25px"],
                            "offset": [2, 23],
                            "layer": 1,
                            "$scrolling_content": "play.server_scroll_panel"
                          }
                        }
                      ],
                      "bindings": [
                        {
                          "binding_type": "view",
                          "source_control_name": "play_server_section",
                          "source_property_name": "#toggle_state",
                          "target_property_name": "#visible"
                        }
                      ],
                      "layer": 2
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "padding4": {
          "type": "panel",
          "size": [0, 22]
        }
      }
    ]
  },

  "quick_button": {
    "type": "stack_panel",
    "size": ["100%",20],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "layer": 1,
    "offset": [0, 1],
    "$button_font_type": "NotoSans-Regular",
    "orientation": "horizontal",
    "controls": [
      {
        "padding1":{
          "type": "panel",
          "size": [1,1]
        }
      },
      { "create_new_world@play.create_new_world_button": { "size": [ "fill", "20px" ] } },
      {
        "padding2":{
          "type": "panel",
          "size": [1,1]
        }
      },
      { "quick_play@play.quick_play_button": { "size": [ "fill", "20px" ] } },
      {
        "padding3":{
          "type": "panel",
          "size": [1,1]
        }
      },
      {
        "add_server@play.add_server_toggle_button": {
          "size": [ "fill", "20px" ]
        }
      },
      {
        "padding4":{
          "type": "panel",
          "size": [1,1]
        }
      }
    ]
  }
}