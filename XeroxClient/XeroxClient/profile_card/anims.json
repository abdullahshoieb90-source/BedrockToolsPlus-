{
  "namespace": "profile_card",

  "dialog_exit_animation_push_offset": {
    "anim_type": "offset",
    "easing": "out_cubic",
    "duration": 0.6,
    "from": [ 0, 0 ],
    "to": [ 0, "-100%" ],
    "play_event": "screen.exit_push",
    "end_event": "screen.exit_end"
  },

  "dialog_exit_animation_pop_offset": {
    "anim_type": "offset",
    "easing": "out_cubic",
    "duration": 0.6,
    "from": [ 0, 0 ],
    "to": [ 0, "-100%" ],
    "play_event": "screen.exit_pop",
    "end_event": "screen.exit_end"
  },

  "dialog_entrance_animation_push_offset": {
    "anim_type": "offset",
    "easing": "out_cubic",
    "duration": 0.6,
    "from": [ 0, "-100%" ],
    "to": [ 0, 0 ],
    "play_event": "screen.entrance_push",
    "end_event": "screen.entrance_end"
  },

  "dialog_entrance_animation_pop_offset": {
    "anim_type": "offset",
    "easing": "out_cubic",
    "duration": 0.6,
    "from": [ 0, "-100%" ],
    "to": [ 0, 0 ],
    "play_event": "screen.entrance_pop",
    "end_event": "screen.entrance_end"
  },
}