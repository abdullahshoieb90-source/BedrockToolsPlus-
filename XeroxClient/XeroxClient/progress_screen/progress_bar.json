{
  "namespace": "progress_bar",
  "empty": {
    "type": "image",
    "size": ["75%", 5],
    "max_size": [310, 5],
    "texture": "textures/ui/progress/progress_bar",
    "alpha": 0.8,
    "layer": 1,
    "color": [0.01, 0.01, 0.99]
  },

  "full": {
    "type": "image",
    "size": ["75%", 5],
    "max_size": [310, 5],
    "texture": "textures/ui/progress/progress_bar",
    "clip_direction": "left",
    "clip_pixelperfect": false,
    "layer": 2,
    "bindings": [
      {
        "binding_name": "#loading_bar_percentage",
        "binding_name_override": "#clip_ratio"
      }
    ]
  },

  "content": {
    "type": "panel",
    "size": ["100%", 7],
    "controls": [
      { "empty@progress_bar.empty": {} }
      { "full@progress_bar.full": {} }
    ],
    "bindings": [
      {
        "binding_name": "#loading_bar_visible",
        "binding_name_override": "#visible"
      }
    ]
  }
}