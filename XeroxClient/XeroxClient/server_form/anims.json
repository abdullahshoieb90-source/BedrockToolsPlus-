{
  "namespace": "server_form_animation",
  "form_out_animation": {
    "anim_type": "size",
    "easing": "in_out_cric",
    "duration": 0.6,
    "to": [235, "25%"],
    "from": [235, "80%"],
    "play_event": "screen.exit_push",
    "reset_event": "screen_animation_reset"
  },

  "form_out_animation_pop": {
    "anim_type": "size",
    "easing": "in_out_cric",
    "duration": 0.6,
    "to": [235, "25%"],
    "from": [235, "80%"],
    "play_event": "screen.exit_pop",
    "reset_event": "screen_animation_reset"
  },

  "form_enter_animation": {
    "anim_type": "size",
    "easing": "out_cric",
    "duration": 0.6,
    "from": [235, "25%"],
    "to": [235, "80%"],
    "play_event": "screen.entrance_push",
    "end_event": "screen.entrance_end"
  },

  "form_enter_animation_pop": {
    "anim_type": "size",
    "easing": "out_cric",
    "duration": 0.6,
    "from": [235, "25%"],
    "to": [235, "80%"],
    "play_event": "screen.entrance_pop",
    "end_event": "screen.entrance_end"
  }
}