{
  "namespace": "start_bottom_info_panel",

  "copyright": {
    "type": "label",
    "layer": 6,
    "text": "Copyright Mojang AB. Don't distribute!",
    "font_type": "Roboto-Regular",
    "size": [ "default", "default" ],
    "offset": [-10, -7.5],
    "color": [0.6, 0.6, 0.6],
    "max_size": [ "100%", "100%" ],
    "anchor_from": "bottom_right",
    "anchor_to": "bottom_right",
    "font_scale_factor": 0.75
  },

  "development_version": {
    "type": "label",
    "layer": 6,
    "font_type": "Roboto-Regular",
    "text": "#development_version",
    "size": [ "default", "default" ],
    "color": [0.6, 0.6, 0.6],
    "offset": [0, -0],
    "bindings": [
      {
        "binding_name": "#development_version"
      }
    ],
    "font_scale_factor": 0.75
  },

  "version": {
    "type": "label",
    "layer": 6,
    "font_type": "Roboto-Regular",
    "text": "#version",
    "size": [ "default", "default" ],
    "anchor_from": "top_right",
    "anchor_to": "top_right",
    "color": [0.6, 0.6, 0.6],
    "offset": [-10, 0],
    "bindings": [
      {
        "binding_name": "#version"
      }
    ],
    "font_scale_factor": 0.75
  },

  "Client_info": {
    "type": "label",
    "text": "( $ClientName - '§b' - '§7' + ' ' + $ClientVersion + ' | '+ $ClientAuthor )",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "offset": [10, 0],
    "color": [0.6, 0.6, 0.6],
    "size": [ "default", "default" ],
    "font_type": "Roboto-Regular",
    "layer": 6,
    "font_scale_factor": 0.75
  },

  "Client_info_2": {
    "type": "label",
    "text": "( $system + ' - ' + $version + ' | ' + $mode )",
    "anchor_from": "bottom_left",
    "anchor_to": "bottom_left",
    "size": [ "default", "default" ],
    "font_type": "Roboto-Regular",
    "color": [0.6, 0.6, 0.6],
    "offset": [10, -7.5],
    "layer": 6,
    "variables": [
      {
        "requires": "$is_win10_arm",
        "$version": "Windows 10 ARM"
      },
      {
        "requires": "$is_windows_10_mobile",
        "$version": "Windows 10 Mobile"
      },
      {
        "requires": "$win10_edition",
        "$version": "Windows 10"
      },
      {
        "requires": "$is_ios",
        "$version": "iOS"
      },
      {
        "requires": "$osx_edition",
        "$version": "Mac OS"
      },
      {
        "requires": "$is_android",
        "$version": "Android"
      },
      {
        "requires": "$google_os",
        "$system": "Google"
      },
      {
        "requires": "$apple_os",
        "$system": "Apple"
      },
      {
        "requires": "$microsoft_os",
        "$system": "Microsoft"
      },
      {
        "requires": "$nx_os",
        "$system": "NX"
      },
      {
        "requires": "$is_ps4",
        "$version": "PS4"
      },
      {
        "requires": "$console_edition",
        "$version": "Console"
      },
      {
        "requires": "$game_pad",
        "$mode": "Controller"
      },
      {
        "requires": "$mouse",
        "$mode": "Keyboard & Mouse"
      },
      {
        "requires": "$touch",
        "$mode": "Touch"
      }
    ],
    "font_scale_factor": 0.75
  },

  "bottom_info_panel_content": {
    "type": "panel",
    "size": ["100%", 24],
    "layer": 7,
    "anchor_from": "bottom_middle",
    "anchor_to": "bottom_middle",
    "controls": [
      { "copyright@start_bottom_info_panel.copyright": {} },
      { "development_version@start_bottom_info_panel.development_version": { "ignored": "$is_publish" } },
      { "version@start_bottom_info_panel.version": {} },
      { ".@start_bottom_info_panel.Client_info": {} },
      { "..@start_bottom_info_panel.Client_info_2": {} }
    ],
    "animation_reset_name": "screen_animation_reset",
    "anims": [
      "@start_animation.bottom_text_out_animation",
      "@start_animation.bottom_text_out_animation_pop",
      "@start_animation.bottom_text_enter_animation",
      "@start_animation.bottom_text_enter_animation_pop"
    ]
  }
}