{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.damage": {
      "initial_state": "default",
      "states": {
        "default": {
          "transitions": [
            { "damage": "v.hurt_time" }
          ]
        },
        "damage": {
          "on_entry": ["v.life_time = q.life_time;"],
          "particle_effects": [
            {
              "effect": "damage",
              "locator": "damage"
            }
          ],
          "transitions": [
            { "default": "q.life_time-v.life_time >= 0.5" }
          ]
        }
      }
    }
  }
}