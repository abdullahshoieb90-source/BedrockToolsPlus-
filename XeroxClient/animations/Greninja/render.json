{
  "format_version": "1.8.0",
  "animations": {
    "animation.render": {
      "loop": true,
      "bones": {
        "root": {
          "position": ["v.render = 1.0;", 0, 0]
          //"rotation": [0, "v.paperdoll_debug", 0]
        }
      }
    },
    "animation.variables": {
      "loop": true,
      "bones": {
        "body": {
          "rotation": ["v.cam_y_rotation_value = q.camera_rotation(1)<0 ? 360+q.camera_rotation(1) : q.camera_rotation(1); v.hand_bob = q.life_time < 0.01 ? 0.0 : v.hand_bob + ((q.is_on_ground && q.is_alive ? math.clamp(math.sqrt(math.pow(q.position_delta(0), 2.0) + math.pow(q.position_delta(2), 2.0)), 0.0, 0.1) : 0.0) - v.hand_bob) * 0.02; v.direc_hud_render = v.is_paperdoll && q.is_in_ui != 1.0; v.is_enchanted_helmet = q.armor_material_slot(0) == 1 || q.armor_material_slot(0) == 3; v.is_enchanted_chestplate = q.armor_material_slot(1) == 1 || q.armor_material_slot(1) == 3; v.is_enchanted_leggings = q.armor_material_slot(2) == 1 || q.armor_material_slot(2) == 3; v.is_enchanted_boots = q.armor_material_slot(3) == 1 || q.armor_material_slot(3) == 3;", 0, 0]
        }
      }
    }
  }
}