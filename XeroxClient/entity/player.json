      "scripts": {
        "scale": "q.is_in_ui ? 1.0 : (v.is_paperdoll ? 1.0 : 0.9375)",
        "initialize": [
          "v.is_holding_right = 0.0;",
          "v.is_blinking = 0.0;",
          "v.last_blink_time = 0.0;",
          "v.hand_bob = 0.0;",
          "v.render = 0.0;",
          "v.life_time = 0.0;",
          "v.hurt_time = 0.0;",
          "v.cam_y_rotation_value = 0.0;",
          "v.direc_hud_render = 0.0;",
          "v.is_enchanted_helmet = 0.0;",
          "v.is_enchanted_chestplate = 0.0;",
          "v.is_enchanted_leggings = 0.0;",
          "v.is_enchanted_boots = 0.0;",
          "v.paperdoll_debug = 1.0;",
          "v.hurt_color_blend = 0.0;",
          "v.killaura_esp_alpha_blend = 0.0;"
        ],
        "pre_animation": [

          // Enabled 启用 - 1.0;
          // Disabled 禁用 - 0.0;

          // Customizations

          /*/// 受伤颜色 ///*/
          "v.hurt_color_r_custom = 0.5;",
          "v.hurt_color_g_custom = 0.0;",
          "v.hurt_color_b_custom = 0.0;",
          "v.hurt_color_enter_blend_speed = 0.03;", // 受伤颜色入场过渡速度 大于0的任意值 大于不透明度时直接变色, 不过渡
          "v.hurt_color_out_blend_speed = 0.02;", // 受伤颜色出场过渡速度 大于0的任意值 大于不透明度时直接变色, 不过渡
          "v.hurt_color_opacity = 0.6;", // 受伤颜色不透明度 0-1.0 值为0时无色, 值为1.0时不透明

          /*/// 光环 ///*/
          "v.killaura_esp_color_r_custom = 1.0;",
          "v.killaura_esp_color_g_custom = 1.0;",
          "v.killaura_esp_color_b_custom = 1.0;",
          "v.killaura_esp_static_rgb = 0.0;", // 启用静态RGB光环(启用时禁用光环颜色修改)
          "v.killaura_esp_static_rolling_rgb = 1.0;", // 启用静态旋转RGB光环(不启用静态RGB时无效)
          "v.killaura_esp_color_enter_blend_speed = 0.02;", // 光环透明度入场过渡速度 大于0的任意值 大于不透明度时直接变色, 不过渡
          "v.killaura_esp_color_out_blend_speed = 0.005;", // 光环透明度出场过渡速度 大于0的任意值 大于不透明度时直接变色, 不过渡
          "v.killaura_esp_color_opacity = 0.75;", // 受伤颜色不透明度 0-1.0 值为0时无色, 值为1.0时不透明

          "v.helmet_layer_visible = 1.0;",
          "v.leg_layer_visible = 1.0;",
          "v.boot_layer_visible = 1.0;",
          "v.chest_layer_visible = 1.0;",
          "v.attack_body_rot_y = Math.sin(360*Math.sqrt(v.attack_time)) * 5.0;",
          "v.tcos0 = (math.cos(q.modified_distance_moved * 38.17) * q.modified_move_speed / v.gliding_speed_value) * 57.3;",
          "v.first_person_rotation_factor = math.sin((1 - v.attack_time) * 180.0);",
          "v.map_angle = math.clamp(1 - v.player_x_rotation / 45.1, 0.0, 1.0);",
          "v.item_use_normalized = q.main_hand_item_use_duration / q.main_hand_item_max_duration;",
          "v.is_third_person = !v.is_first_person && !v.map_face_icon;",
          "v.render_in_hud = q.is_in_ui && q.is_on_screen && q.is_alive;"
        ],
        "animate": [
          "root",
          { "render": "q.is_in_ui" },
          "variables",
          "direction_hud",
          "crosshair",
          "armor_hud",
          "killaura_esp",
          { "jump_circle": "v.render" },
          { "in_ui_fixed": "q.get_equipped_item_name('main_hand') != 'goat_horn' && q.is_in_ui" },
          "damage"/*
          { "hide_armor": "v.hurt_time" },
          { "elytra_controller": "q.armor_texture_slot(1) == 5" }*/
        ]
      },
