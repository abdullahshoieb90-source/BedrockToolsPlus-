{
  "format_version": "1.10.0",
  "render_controllers": {
    "controller.render.greninja_armor.helmet": {
      "arrays": {
        "textures": {
          "array.helmet": [
            "texture.leather_armor",
            "texture.chain_armor",
            "texture.iron_armor",
            "texture.diamond_armor",
            "texture.gold_armor",
            "texture.elytra_armor",
            "texture.turtle_armor",
            "texture.netherite_armor"
          ]
        }
      },
      "geometry": "geometry.armor",
      "materials": [ { "*": "v.is_enchanted_helmet ? material.armor : material.armor_enchanted" }
      ],
      "textures": [
        "array.helmet[q.armor_texture_slot(0)]",
        "texture.enchanted"
      ],
      "part_visibility": [
        {
          "*": false
        },
        {
          "head": true
        },
        {
          "hat": true
        }
      ],
      "color": {
        "r": "query.armor_color_slot(0, 0)",
        "g": "query.armor_color_slot(0, 1)",
        "b": "query.armor_color_slot(0, 2)",
        "a": "1.0"
      },
      "is_hurt_color": {
        "r": "v.hurt_color_r_custom",
        "g": "v.hurt_color_g_custom",
        "b": "v.hurt_color_b_custom",
        "a": "v.hurt_color_blend = v.hurt_time ? math.min((v.hurt_color_blend+v.hurt_color_enter_blend_speed), v.hurt_color_opacity) : math.max((v.hurt_color_blend-v.hurt_color_out_blend_speed), 0.0); return v.hurt_color_blend;"
      },
      "on_fire_color": {
        "r": "v.hurt_color_r_custom",
        "g": "v.hurt_color_g_custom",
        "b": "v.hurt_color_b_custom",
        "a": "v.hurt_color_blend = v.hurt_time ? math.min((v.hurt_color_blend+v.hurt_color_enter_blend_speed), v.hurt_color_opacity) : math.max((v.hurt_color_blend-v.hurt_color_out_blend_speed), 0.0); return v.hurt_color_blend;"
      },
      "overlay_color": {
        "r": "v.hurt_color_r_custom",
        "g": "v.hurt_color_g_custom",
        "b": "v.hurt_color_b_custom",
