{
  "namespace": "add_external_server",

  "play_button": {
    "$default_button_texture": "textures/ui/Xerox/white_border",
    "$hover_button_texture": "textures/ui/popup_dialog/button_hover",
    "$xeroxclient_button_text_color_pressed": "$xeroxclient_ui_theme_popup_dialog_button_text_pressed_color",
    "$xeroxclient_button_alpha_default": 1,
    "$xeroxclient_button_alpha_hover": 1,
    "$xeroxclient_button_alpha_pressed": 1,
    "$xeroxclient_button_color_default": [],
    "$xeroxclient_button_color_hover": [],
    "$xeroxclient_button_color_pressed": []
  },

  "remove_button": {
    "$default_button_texture": "textures/ui/Xerox/white_border",
    "$hover_button_texture": "textures/ui/popup_dialog/button_hover",
    "$xeroxclient_button_text_color_pressed": "$xeroxclient_ui_theme_popup_dialog_button_text_pressed_color",
    "$xeroxclient_button_alpha_default": 1,
    "$xeroxclient_button_alpha_hover": 1,
    "$xeroxclient_button_alpha_pressed": 1,
    "$xeroxclient_button_color_default": [],
    "$xeroxclient_button_color_hover": [],
    "$xeroxclient_button_color_pressed": []
  },

  "save_button": {
    "$default_button_texture": "textures/ui/Xerox/white_border",
    "$hover_button_texture": "textures/ui/popup_dialog/button_hover",
    "$xeroxclient_button_text_color_pressed": "$xeroxclient_ui_theme_popup_dialog_button_text_pressed_color",
    "$xeroxclient_button_alpha_default": 1,
    "$xeroxclient_button_alpha_hover": 1,
    "$xeroxclient_button_alpha_pressed": 1,
    "$xeroxclient_button_color_default": [],
    "$xeroxclient_button_color_hover": [],
    "$xeroxclient_button_color_pressed": []
  },

  "text_edit_group/name_label": {
    "font_type": "$global_font_type"
  },

  "title_text": {
    "font_type": "$global_font_type",
    "text_alignment": "center"
  },

  "content_panel/name_edit": {
    "$max_length": 32767
  },

  "content_panel/ip_edit": {
    "$max_length": 32767
  },

  "content_panel/port_edit": {
    "$max_length": 32767
  },

  "main_panel": {
    "type": "input_panel",
    "size": "$dialog_size",
    "controls": [
      {
        "common_panel@common.common_panel": {
          "$dialog_background": "dialog_image.dialog_background_2"
        }
      },
      {
        "title@add_external_server.title_text": {
          "offset": [ 3, 5 ],
          "size": [ "100%", 15 ],
          "anchor_to": "top_middle",
          "anchor_from": "top_middle"
        }
      },
      {
        "main_content@add_external_server.content_panel": {
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "size": [ "100%-6px", 127 ],
          "offset": [ 3, 24 ]
        }
      },
      {
        "play@add_external_server.play_button": {
          "size": [ "50%-4px", 22 ],
          "anchor_from": "bottom_left",
          "anchor_to": "bottom_left",
          "offset": [ 3, -3 ]
        }
      },
      {
        "play_disabled@add_external_server.play_disabled_button": {
          "ignored": "$edit_mode",
          "size": [ "50%-4px", 22 ],
          "anchor_from": "bottom_left",
          "anchor_to": "bottom_left",
          "offset": [ 3, -3 ],
          "layer": 5
        }
      },
      {
        "remove@add_external_server.remove_button": {
          "size": [ "50%-4px", 22 ],
          "anchor_from": "bottom_left",
          "anchor_to": "bottom_left",
          "offset": [ 3, -3 ]
        }
      },
      {
        "save@add_external_server.save_button": {
          "size": [ "50%-4px", 22 ],
          "anchor_from": "bottom_right",
          "anchor_to": "bottom_right",
          "offset": [ -3, -3]
        }
      },
      {
        "save_disabled@add_external_server.save_disabled_button": {
          "size": [ "50%-4px", 22 ],
          "anchor_from": "bottom_right",
          "anchor_to": "bottom_right",
          "offset": [ -3, -3 ],
          "layer": 1
        }
      }
    ]
  },

  "add_external_server_screen": {
    "$dialog_size": [ 316, 169 ],
    "force_render_below": true,
    "$screen_animations": [
      "@common.screen_exit_animation_push_fade",
      "@common.screen_exit_animation_pop_fade",
      "@common.screen_entrance_animation_push_fade",
      "@common.screen_entrance_animation_pop_fade"
    ]
  }
}