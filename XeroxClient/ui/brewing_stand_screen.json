{
  "namespace": "brewing_stand",
  
  "brewing_pipes": {
    "texture": "textures/ui/Xerox/brewing_stand/brewing_pipes",
    "alpha": 0.65
  },

  "brewing_fuel_pipes": {
    "texture": "textures/ui/Xerox/brewing_stand/brewing_fuel_pipes",
    "alpha": 0.65
  },
  "bottle_empty_image": {
    "texture": "textures/ui/Xerox/brewing_stand/bottle_empty",
    "alpha": 0.65
  },

  "bubbles_empty_image": {
    "texture": "textures/ui/Xerox/brewing_stand/bubbles",
    "alpha": 0.65
  },
  "fuel_empty_image": {
    "texture": "textures/ui/Xerox/brewing_stand/brewing_fuel_empty",
    "alpha": 0.65
  },

  "bubbles_full_image": {
    "texture": "textures/ui/Xerox/brewing_stand/bubbles",
    "alpha": 1.00
  },

  "brewing_arrow_empty_image": {
    "texture": "textures/ui/Xerox/brewing_stand/brewing_arrow_empty",
    "alpha": 0.65
  },

  "brewing_fuel_bar_empty_image": {
    "texture": "textures/ui/Xerox/brewing_stand/brewing_fuel_bar_empty",
    "alpha": 0.65
  },

  "brewing_label": {
    "ignored": true
  },

  "brewing_stand_panel/root_panel/common_panel": {
    "ignored": true
  },

  "brewing_stand_panel/root_panel": {
    "$container_texture": "brewing_stand",
    "$container_name": "$container_title",
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_front",
        "value": [
          { "logo@Xerox_common.client_logo": { "offset": [0, 35]} },
          { "mode_select@inv_quick_mode.inv_mode_select_panel": { "offset": [22, 0] } },
          { "new_common_panel@Xerox_common.inv_common_panel": {} },
          { "paper_doll@chest.paper_doll": {} }
        ]
      }
    ]
  },

  "brewing_stand_panel/root_panel/furnace_screen_inventory": {
    "offset": [0, 5]
  },

  "brewing_stand_screen": {
    "variables": [
      {
        "requires": "$desktop_screen",
        "$screen_content": "brewing_stand.brewing_stand_panel",
        "$screen_bg_content": "common.screen_background",
        "$screen_animations": [
          "@container_animation.container_screen_exit_offset_push",
          "@container_animation.container_screen_exit_offset_pop",
          "@container_animation.container_screen_entrance_offset_push",
          "@container_animation.container_screen_entrance_offset_pop",
          "@container_animation.container_screen_exit_size_push",
          "@container_animation.container_screen_exit_size_pop",
          "@container_animation.container_screen_entrance_size_push",
          "@container_animation.container_screen_entrance_size_pop",
          "@container_animation.container_screen_exit_alpha_push",
          "@container_animation.container_screen_exit_alpha_pop",
          "@container_animation.container_screen_entrance_alpha_push",
          "@container_animation.container_screen_entrance_alpha_pop"
        ]
      },
      {
        "requires": "$pocket_screen",
        "$screen_content": "brewing_stand_pocket.brewing_stand_panel"
      }
    ]
  }
}