{
  "namespace": "cartography",
  "arrow_icon": {
    "texture": "textures/ui/Xerox/others/arrow",
    "alpha": 0.65
  },

  "plus_sign_icon": {
    "texture": "textures/ui/Xerox/others/plus",
    "alpha": 0.65
  },

  "title_label": {
    "ignored": true
  },

  "text_edit_control": {
    "max_length": 32767,
    "enabled_newline": true
  },

  "text_box_panel/map_name_label": {
    "font_type": "$global_font_type"
  },

  "text_box_panel/text_edit_control": {
    "ignored": true
  },

  "text_box_panel": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": [
          { "text_edit_content@cartography.text_edit_content": {} }
        ]
      }
    ]
  },

  "text_edit_content": {
    "type": "stack_panel",
    "size": ["100%", 20],
    "orientation": "horizontal",
    "controls": [
      {
        "text_edit_control@cartography.text_edit_control": {
          "size": ["fill", 20]
        }
      },
      {
        "larger_text_edit_box_toggle@common_toggles.dark_ui_toggle": {
          "size": [20, 20],
          "$toggle_name": "larger_text_edit_box_toggle",
          "$button_type_panel": "anvil.expand",
          "$toggle_view_binding_name": "larger_text_edit_box"
        }
      }
    ]
  },

  "output_description_label": {
    "font_type": "$global_font_type"
  },

  "top_half_panel": {
    "offset": [ 0, 7 ]
  },

  "larger_text_edit_box_panel@common.root_panel": {
    "size": [146, 220],
    "controls": [
      {
        "bg@Xerox_common.inv_common_panel": {
          "$inv_top_visible": false
        }
      },
      {
        "text_edit_box@common.scrollable_multiline_text_edit_box": {
          "size": ["100% - 12px", "100% - 12px"],
          "$place_holder_text": "#text_box_placeholder_name",
          "$text_edit_box_placeholder_content_binding_name": "#text_box_placeholder_name",
          "max_length": 32767
        }
      }
    ]
  },
  "right_panel@common.root_panel": {
    "$container_texture": "cartography",
    "$container_name": "tile.cartography_table.name",
    "size": [ 176, 220 ],
    "layer": 1,
    "controls": [
      { "mode_select@inv_quick_mode.inv_mode_select_panel": { "offset": [22, 0] } },
      { "new_common_panel@Xerox_common.inv_common_panel": {} },
      {
        "cartography_screen_inventory": {
          "type": "panel",
          "layer": 2,
          "controls": [
            { "top_half_panel@cartography.top_half_panel": {} },
            { "inventory_panel_bottom_half_with_label@common.inventory_panel_bottom_half_with_label": {} },
            { "hotbar_grid@common.hotbar_grid_template": {} },
            { "inventory_take_progress_icon_button@common.inventory_take_progress_icon_button": {} }
          ]
        }
      },
      { "inventory_selected_icon_button@common.inventory_selected_icon_button": {} },
      { "gamepad_cursor@common.gamepad_cursor_button": {} }
    ]
  },

  "cartography_panel/root_panel/common_panel": {
    "ignored": true
  },

  "cartography_panel/root_panel/tab_close_and_help_button": {
    "ignored": true
  },

  "screen_stack_panel": {
    "type": "stack_panel",
    "orientation": "horizontal",
    "size": [ "100%c", "100%cm" ],
    "controls": [
      {
        "left_panel": {
          "type": "stack_panel",
          "orientation": "horizontal",
          "size": [ "100%c", "100%cm" ],
          "controls": [
            { "larger_text_edit_box_panel@cartography.larger_text_edit_box_panel": {} },
            {
              "center_fold": {
                "type": "panel",
                "size": [4, 0]
              }
            }
          ],
          "bindings": [
            {
              "binding_type": "view",
              "source_control_name": "larger_text_edit_box",
              "source_property_name": "#toggle_state",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "paperdoll_panel": {
          "type": "panel",
          "size": [0, 220],
          "controls": [
            { "paper_doll@chest.paper_doll": {} }
          ],
          "bindings": [
            {
              "resolve_sibling_scope": true,
              "binding_type": "view",
              "source_control_name": "larger_text_edit_box",
              "source_property_name": "(not #toggle_state)",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      { "right_panel@cartography.right_panel": {} }
    ]
  },

  "cartography_panel/root_panel": {
    "ignored": true
  },

  "cartography_panel": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_front",
        "value": [
          { "screen_stack_panel@cartography.screen_stack_panel": {} },
          {
            "logo_panel": {
              "type": "panel",
              "size": [0, 220],
              "controls": [
                { "logo@Xerox_common.client_logo": { "offset": [0, 35]} }
              ]
            }
          }
        ]
      }
    ]
  },

  "cartography_screen": {
    "variables": [
      {
        "requires": "$desktop_screen",
        "$screen_content": "cartography.cartography_panel",
        "$screen_bg_content": "common.screen_background",
        "$screen_animations": [
          "@container_animation.container_screen_exit_offset_push",
          "@container_animation.container_screen_exit_offset_pop",
          "@container_animation.container_screen_entrance_offset_push",
          "@container_animation.container_screen_entrance_offset_pop",
          "@container_animation.container_screen_exit_size_push",
          "@container_animation.container_screen_exit_size_pop",
          "@container_animation.container_screen_entrance_size_push",
          "@container_animation.container_screen_entrance_size_pop",
          "@container_animation.container_screen_exit_alpha_push",
          "@container_animation.container_screen_exit_alpha_pop",
          "@container_animation.container_screen_entrance_alpha_push",
          "@container_animation.container_screen_entrance_alpha_pop"
        ]
      },
      {
        "requires": "$pocket_screen",
        "$screen_content": "cartography_pocket.cartography_panel"
      }
    ]
  }
}
