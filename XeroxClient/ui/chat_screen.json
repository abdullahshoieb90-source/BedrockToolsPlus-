{
  "namespace": "chat",

  "background": {
    "texture": "textures/ui/Xerox/Black",
    "alpha": 0.75,
    "type": "image"
  },

  "text_edit_box": {
    "max_length": 32767,
    "$place_holder_text": "Enter what you want to say..."
  },

  "messages_text/text": {
    "font_type": "$global_font_type",
    "size": ["default", "default"],
    "max_size": ["100%", "default"],
    "offset": [2, 0],
    "anchor_from": "left_middle",
    "anchor_to": "left_middle"
  },

  "messages_stack_panel": {
    "factory": {
      "name": "messages_factory",
      "max_children_size": 32767,
      "control_ids": {
        "chat_screen_messages": "chat_screen_messages@chat.message_tts_wrapper"
      }
    }
  },
  "messages_scrolling_panel@common.scrolling_panel": {
    "type": "panel",
    "size": [ "100%-2px", "100%-50px" ],
    "anchor_from": "bottom_left",
    "anchor_to": "bottom_left",
    "offset": [ 0, -27 ],
    "$scrolling_content": "chat.messages_stack_panel",
    "$scroll_size": [ 5, "100%-4px" ],
    "$jump_to_bottom_on_update": false,
    "$show_background": false,
    "$always_handle_scrolling": true,
    "clips_children": true
  },

  "click_autocomplete_is_focused": {
    "type": "image",
    "texture": "textures/ui/Xerox/white_border",
    "color": [1, 1, 1]
  },

  "auto_complete_panel_contents_with_item/text": {
    "offset": [ 4, 0 ],
    "font_type": "$global_font_type"
  },

  "chat_screen@common.base_screen": {
    "$screen_content": "chat_main_screen.chat_screen_content",
    "$screen_bg_content": "chat.background",
    "$screen_animations|default": [
      "@common.screen_exit_animation_push_fade",
      "@common.screen_exit_animation_pop_fade",
      "@common.screen_entrance_animation_push_fade",
      "@common.screen_entrance_animation_pop_fade"
    ]
  }
}