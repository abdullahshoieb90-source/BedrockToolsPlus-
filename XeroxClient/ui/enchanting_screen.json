{
  "namespace": "enchanting",
  "lapis_image": {
    "texture": "textures/ui/Xerox/enchanting/lapis_image",
    "alpha": 0.65
  },

  "background_with_hover_text/hover_text": {
    "ignored": true
  },

  "active_background_with_hover_text": {
    "texture": "textures/ui/Xerox/image/button/hover",
    "alpha": 0.2
  },

  "active_background": {
    "texture": "textures/ui/Xerox/Black",
    "alpha": 0.2
  },

  "dark_background_with_hover_text": {
    "texture": "textures/ui/Xerox/Black",
    "alpha": 0.2
  },

  "dark_background": {
    "texture": ""
  },

  "enchant_runes": {
    "type": "label",
    "color": "$enchanting_runes_color",
    "shadow": true,
    "layer": 1,
    "anchor_to": "left_middle",
    "anchor_from": "left_middle",
    "text": "#hover_text",
    "font_type": "$global_font_type",
    "offset": [18, 4],
    "size": [84, 16],
    "bindings": [
      {
        "binding_name": "#hover_text",
        "binding_collection_name": "#enchant_buttons",
        "binding_type": "collection"
      }
    ]
  },

  "enchant_cost": {
    "font_type": "$global_font_type"
  },

  "enchanting_label": {
    "ignored": true
  },

  "enchanting_panel/root_panel/common_panel": {
    "ignored": true
  },

  "enchanting_panel/root_panel": {
    "$container_texture": "enchanting",
    "$container_name": "$container_title",
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_front",
        "value": [
          { "logo@Xerox_common.client_logo": { "offset": [0, 35]} },
          { "mode_select@inv_quick_mode.inv_mode_select_panel": { "offset": [22, 0] } },
          { "new_common_panel@Xerox_common.inv_common_panel": {} },
          { "paper_doll@chest.paper_doll": {} }
        ]
      }
    ]
  },

  "enchanting_panel/root_panel/enchanting_screen_inventory/enchanting_panel_top_half": {
    "offset": [0, 14]
  },

  "enchanting_screen": {
    "variables": [
      {
        "requires": "$desktop_screen",
        "$screen_content": "enchanting.enchanting_panel",
        "$screen_bg_content": "common.screen_background",
        "$screen_animations": [
          "@container_animation.container_screen_exit_offset_push",
          "@container_animation.container_screen_exit_offset_pop",
          "@container_animation.container_screen_entrance_offset_push",
          "@container_animation.container_screen_entrance_offset_pop",
          "@container_animation.container_screen_exit_size_push",
          "@container_animation.container_screen_exit_size_pop",
          "@container_animation.container_screen_entrance_size_push",
          "@container_animation.container_screen_entrance_size_pop",
          "@container_animation.container_screen_exit_alpha_push",
          "@container_animation.container_screen_exit_alpha_pop",
          "@container_animation.container_screen_entrance_alpha_push",
          "@container_animation.container_screen_entrance_alpha_pop"
        ]
      },
      {
        "requires": "$pocket_screen",
        "$screen_content": "enchanting_pocket.enchanting_panel"
      }
    ]
  }
}