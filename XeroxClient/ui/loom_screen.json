{
  "namespace": "loom",
  "arrow_icon": {
    "texture": "textures/ui/Xerox/others/arrow_large",
    "alpha": 0.65
  },

  "banner_outline": {
    "texture": "textures/ui/Xerox/Black",
    "alpha": 0.35
  },

  "item_empty_image": {
    "alpha": 0.65
  },

  "banner_empty_image": {
    "texture": "textures/ui/Xerox/loom/loom_banner_empty"
  },

  "dye_empty_image": {
    "texture": "textures/ui/Xerox/loom/loom_dye_empty"
  },

  "pattern_item_empty_image": {
    "texture": "textures/ui/Xerox/loom/loom_pattern_item_empty"
  },

  "toolbar_anchor": {
    "ignored": true
  },

  "loom_label": {
    "ignored": true
  },

  "right_panel/common_panel": {
    "ignored": true
  },

  "right_panel": {
    "$container_texture": "loom",
    "$container_name": "container.loom",
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_front",
        "value": [
          { "mode_select@inv_quick_mode.inv_mode_select_panel": { "offset": [22, 0] } },
          { "new_common_panel@Xerox_common.inv_common_panel": {} }
        ]
      }
    ]
  },

  "pattern_book_panel/bg": {
    "ignored": true
  },

  "pattern_book_panel": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": [
          {
            "background@Xerox_common.inv_common_panel": {
              "$inv_top_visible": false
            }
          }
        ]
      }
    ]
  },
  "center_fold/center_bg": {
    "ignored": true
  },

  "center_fold": {
    "modifications": []
  },

  "loom_panel": {
    "controls": [
      {
        "logo_panel": {
          "type": "panel",
          "size": [0, 166],
          "controls": [
            { "logo@Xerox_common.client_logo": { "offset": [0, 35] } }
          ]
        }
      },
      { "screen_stack_panel@loom.screen_stack_panel": {} },

      { "container_gamepad_helpers@common.container_gamepad_helpers": {} },
      { "selected_item_details_factory@common.selected_item_details_factory": {} },
      { "item_lock_notification_factory@common.item_lock_notification_factory": {} },
      { "inventory_selected_icon_button@common.inventory_selected_icon_button": {} },
      { "inventory_take_progress_icon_button@common.inventory_take_progress_icon_button": {} }
    ]
  },

  "loom_screen": {
    "variables": [
      {
        "requires": "$desktop_screen",
        "$screen_content": "loom.loom_panel",
        "$screen_bg_content": "common.screen_background",
        "$screen_animations": [
          "@container_animation.container_screen_exit_offset_push",
          "@container_animation.container_screen_exit_offset_pop",
          "@container_animation.container_screen_entrance_offset_push",
          "@container_animation.container_screen_entrance_offset_pop",
          "@container_animation.container_screen_exit_size_push",
          "@container_animation.container_screen_exit_size_pop",
          "@container_animation.container_screen_entrance_size_push",
          "@container_animation.container_screen_entrance_size_pop",
          "@container_animation.container_screen_exit_alpha_push",
          "@container_animation.container_screen_exit_alpha_pop",
          "@container_animation.container_screen_entrance_alpha_push",
          "@container_animation.container_screen_entrance_alpha_pop"
        ]
      },
      {
        "requires": "$pocket_screen",
        "$screen_content": "loom_pocket.loom_panel"
      }
    ]
  }
