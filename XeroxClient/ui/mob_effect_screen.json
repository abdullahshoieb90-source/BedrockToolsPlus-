{// Made By Vargoo. & Greninja.
  "namespace": "mob_effect",

  "main_background": {
    "visible": false
  },

  "effect_name": {
    "shadow": true,
    "font_type": "$global_font_type",
    "offset": [25, 2.5],
    "color": "$name_color"
  },

  "effect_timer": {
    "shadow": true,
    "offset": [25, -2.5],
    "font_type": "$global_font_type",
    "color": "$timer_color",
    "text": "$timer_text"
  },

  "effect_icon": {
    "size": [20, 20],
    "anchor_from": "left_middle",
    "anchor_to": "left_middle",
    "offset": [3, 0]
  },

  "mob_effect_draggable_panel": {
    "type": "input_panel",
    "size": ["100%c", "100%c"],
    "draggable": "both",
    "offset": [1, "20%"],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "prevent_touch_input": true,
    "button_mappings": [
      {
        "from_button_id": "button.menu_select",
        "to_button_id": "xeroxclient.mob_effect_dragbble",
        "consume_event": false,
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.menu_ok",
        "to_button_id": "xeroxclient.mob_effect_dragbble",
        "consume_event": false,
        "mapping_type": "pressed"
      }
    ],
    "controls": [
      {
        "content@mob_effect.mob_effect_grid_panel": {
          "offset": []
        }
      }
    ]
  },

  "mob_effect_grid_panel": {
    "type": "stack_panel",
    "offset": [1, "20%"],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "size": ["100%cm", "100%c"],
    "controls": [
      { "mob_effect_grid@mob_effect.mob_effect_grid": {} }
    ]
  },

  "mob_effect_grid": {
    "size": [100, "default"],
    "grid_item_template": "mob_effect.mob_effect_grid_item_template"
  },

  "touch_zone": {
    "type": "input_panel",
    "size": ["50%-35px", 35],
    "anchor_from": "top_right",
    "anchor_to": "top_right",
    "bindings": [
      {
        "binding_name": "#inventory_touch_button",
        "binding_name_override": "#visible",
        "binding_type": "global"
      }
    ],
    "prevent_touch_input": true,
    "button_mappings": [
      {
        "from_button_id": "button.menu_select",
        "to_button_id": "button.menu_continue",
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.menu_ok",
        "to_button_id": "button.menu_continue",
        "mapping_type": "pressed"
      }
    ]
  },

  "mob_effect_grid_item_template": {
    "type": "panel",
    "size": [100, 25],
    "controls": [
      {
        "time_longer_than_10s": {
          "type": "panel",
          "controls": [
            {
              "1@mob_effect.mob_effect_grid_item": {
                "$timer_text|default": "#mob_effect_timer",
                "$timer_color|default": "$mob_effect_timer_color",
                "$name_color|default": "$mob_effect_name_color",
                "bindings": [
                  {
                    "binding_type": "collection",
                    "binding_name": "#mob_effect_timer",
                    "binding_collection_name": "mob_effects_collection",
                    "binding_condition": "always"
                  },
                  {
                    "binding_type": "view",
                    "source_property_name": "(((#mob_effect_timer - ':') > 10) and ((#mob_effect_timer - ':') < 2719))",
                    "target_property_name": "#visible"
                  }
                ]
              }
            },
            {
              "2@mob_effect.mob_effect_grid_item": {// For be like Java Edition
                "$timer_text|default": "**:**",
                "$timer_color|default": "$mob_effect_timer_color",
                "$name_color|default": "$mob_effect_name_color",
                "bindings": [
                  {
                    "binding_type": "collection",
                    "binding_name": "#mob_effect_timer",
                    "binding_collection_name": "mob_effects_collection",
                    "binding_condition": "always"
                  },
                  {
                    "binding_type": "view",
                    "source_property_name": "(((#mob_effect_timer - ':') = 2719) or ((#mob_effect_timer - ':') > 2719))",
                    "target_property_name": "#visible"
                  }
                ]
              }
            }
          ],
          "bindings": [
            {
              "binding_type": "collection",
              "binding_name": "#mob_effect_timer",
              "binding_collection_name": "mob_effects_collection",
              "binding_condition": "always"
            },
            {
              "binding_type": "view",
              "source_property_name": "((#mob_effect_timer - ':') > 10)",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "time_less_than_10s@mob_effect.mob_effect_grid_item": {
          //"alpha": "@mob_effect.glitter",
          //"disable_anim_fast_forward": true,
          "$timer_text|default": "#mob_effect_timer",
          "$timer_color|default": "$mob_effect_disappear_soon_timer_color",
          "$name_color|default": "$mob_effect_name_color",
          "bindings": [
            {
              "binding_type": "collection",
              "binding_name": "#mob_effect_timer",
              "binding_collection_name": "mob_effects_collection",
              "binding_condition": "always"
            },
            {
              "binding_type": "view",
              "source_property_name": "(((#mob_effect_timer - ':') = 10) or ((#mob_effect_timer - ':') < 10))",
              "target_property_name": "#visible"
            }
          ]
        }
      }
    ]
  },
/*
  "glitter": {
    "anim_type": "alpha",
    "duration": 0.4,
    "from": 1,
    "to": 0.01,
    "next": "@mob_effect.glitter2"
  },

  "glitter2": {
    "anim_type": "alpha",
    "duration": 0.4,
    "to": 1,
    "from": 0.01,
    "next": "@mob_effect.glitter"
  },
*/
  "mob_effect_grid_item": {
    "type": "input_panel",
    "size": [100, 25],
    "propagate_alpha": true,
    "controls": [
      { "name@mob_effect.effect_name": { "layer": 1 } },
      { "timer@mob_effect.effect_timer": { "layer": 1 } },
      { "icon@mob_effect.effect_icon": { "layer": 1 } }
    ],
    "prevent_touch_input": true,
    "button_mappings": [
      {
        "from_button_id": "button.menu_select",
        "to_button_id": "button.menu_continue",
        "mapping_type": "double_pressed"
      },
      {
        "from_button_id": "button.menu_ok",
        "to_button_id": "button.menu_continue",
        "mapping_type": "double_pressed"
      }
    ]
  },

  "mob_effect_screen": {
    "close_on_player_hurt": false,
    "should_steal_mouse": true,
    "absorbs_input": false,
    "is_showing_menu": false,
    "force_render_below": true,
    "$use_loading_bars": false,
    "$screen_content": "mob_effect.mob_effect_grid_panel",
    "$screen_animations|default": [
      "@mob_effect.screen_exit_animation_push_offset",
      "@mob_effect.screen_exit_animation_pop_offset",
      "@mob_effect.screen_entrance_animation_push_offset",
      "@mob_effect.screen_entrance_animation_pop_offset",
      "@common.screen_exit_animation_push_fade",
      "@common.screen_exit_animation_pop_fade",
      "@common.screen_entrance_animation_push_fade",
      "@common.screen_entrance_animation_pop_fade"
    ]
  }
}