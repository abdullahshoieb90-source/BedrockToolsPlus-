  "play_screen": {
    "$screen_animations": [],
    "$screen_content": "play_main_screen.main_screen_panel",
    "$text_color": [1.0, 1.0, 1.0],
    "$secondary_text_color": [0.7, 0.7, 0.7],
    "$enabled_tab_anim": true
  },

  "join_by_code_popup_background": {
    "ignored": true
  },

  "join_by_code_popup_content": {
    "propagate_alpha": true,
    "anims": [
      "@common.screen_exit_animation_push_fade",
      "@common.screen_exit_animation_pop_fade",
      "@common.screen_entrance_animation_push_fade",
      "@common.screen_entrance_animation_pop_fade"
    ],
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_front",
        "value": [
          { "background@dialog_image.dialog_background_2": { "layer": 0 } }
        ]
     }
    ]
  },

  "join_by_code_popup_content/popup_dialog_bg": {
    "ignored": true
  },

  "join_by_code_popup_code_text_field": {
    "max_length": 32767
  },

  "join_by_code_popup_join_button": {
    "$default_button_texture": "textures/ui/Xerox/white_border",
    "$hover_button_texture": "textures/ui/popup_dialog/button_hover",
    "$xeroxclient_button_text_color_pressed": "$xeroxclient_ui_theme_popup_dialog_button_text_pressed_color",
    "$xeroxclient_button_alpha_default": 1,
    "$xeroxclient_button_alpha_hover": 1,
    "$xeroxclient_button_alpha_pressed": 1,
    "$xeroxclient_button_color_default": [],
    "$xeroxclient_button_color_hover": [],
    "$xeroxclient_button_color_pressed": []
  },

  "popup_two_buttons": {
    "size": [ 200, 100 ],
    "propagate_alpha": true,
    "$child_control": "play.high_ping_popup_content_scrolling_panel",
    "anims": [
      "@common.screen_exit_animation_push_fade",
      "@common.screen_exit_animation_pop_fade",
      "@common.screen_entrance_animation_push_fade",
      "@common.screen_entrance_animation_pop_fade"
    ]
  },

  "high_ping_popup_content_scrolling_panel@common.scrolling_panel": {
    "$show_background": false,
    "$scrolling_content": "play.high_ping_popup_content_stack_panel"
  },

  "high_ping_popup_content_stack_panel": {
    "size": ["100%", "100%c"]
  },

  "popup_two_buttons/common_panel": {
    "$dialog_background": "dialog_image.dialog_background_2"
  },

  "popup_two_buttons/title_label": {
    "offset": [ 0, 4.5 ]
  },

  "popup_two_buttons/panel_indent": {
    "size": [ "100% - 8px", "100% - 44px" ],
    "offset": [ 0, 18 ]
  },

  "popup_two_buttons/button_panel": {
    "size": [ "100% - 6px", 22 ],
    "offset": [ 0, -3 ]
  },

  "popup_two_buttons/button_panel/left_button_panel": {
    "size": [ "50%", "100%" ]
  },

  "popup_two_buttons/button_panel/pad": {
    "ignored": true
  },

  "popup_two_buttons/button_panel/right_button_panel": {
    "size": [ "50%", "100%" ]
  },

  "high_ping_popup_join_button": {
    "$default_button_texture": "textures/ui/Xerox/white_border",
    "$hover_button_texture": "textures/ui/popup_dialog/button_hover",
    "$xeroxclient_button_text_color_pressed": "$xeroxclient_ui_theme_popup_dialog_button_text_pressed_color",
    "$xeroxclient_button_alpha_default": 1,
    "$xeroxclient_button_alpha_hover": 1,
    "$xeroxclient_button_alpha_pressed": 1,
    "$xeroxclient_button_color_default": [],
    "$xeroxclient_button_color_hover": [],
    "$xeroxclient_button_color_pressed": []
  },

  "high_ping_popup_cancel_button": {
