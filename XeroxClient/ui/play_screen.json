{
  "namespace": "play",

  "servers_content_panel/more_servers_divider": {
    "ignored": true
  },

  "servers_content_panel/featured_servers_panel": {
    "bindings": [
      {
        "binding_type": "view",
        "source_control_name": "featured_servers",
        "source_property_name": "#toggle_state",
        "target_property_name": "#visible"
      }
    ]
  },

  "servers_content_panel/more_servers_panel": {
    "bindings": [
      {
        "binding_type": "view",
        "source_control_name": "additional_servers",
        "source_property_name": "#toggle_state",
        "target_property_name": "#visible"
      }
    ]
  },

  "server_scroll_panel/stack_panel/add_server_button": {
    "ignored": true
  },

  "server_button_content_panel": {
    "variables": [],
    "$border_texture": "textures/ui/default_indent"
  },

  "server_button_content_panel/padding": {
    "controls": [
      {
        "ping@play.ping_rate_panel": {
          "anchor_from": "right_middle",
          "anchor_to": "right_middle"
        }
      }
    ]
  },

  "featured_server_world_item/server_button": {
    "ignored": true
  },

  "more_servers_world_item/additional_server_toggle_base": {
    "ignored": true
  },

  "featured_server_world_item": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_front",
        "value": [
          { "server_button_base@play.server_button_base": {} }
        ]
      }
    ]
  },

  "more_servers_world_item": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_front",
        "value": [
          { "server_button_base@play.additional_server_button_base": {} }
        ]
      }
    ]
  },

  "additional_server_button_base@common_buttons.dark_content_button": {
    "$pressed_button_name": "button.menu_network_world_item",
    "$focus_override_right": "edit_server",
    "size": [ "fill", "100% + 1px" ],
    "layer": 1,
    "$button_content": "play.additional_server_toggle_content",
    "bindings": [
      {
        "binding_type": "collection_details",
        "binding_collection_name": "$collection_name"
      },
      {
        "binding_name": "#cross_platform_enabled",
        "binding_name_override": "#enabled"
      }
    ]
  },

  "server_button_base@common_buttons.dark_content_button": {
    "$pressed_button_name": "button.menu_network_world_item",
    "size": [ "100%", "100% - 2px" ],
    "$button_content": "play.server_button_content_panel",
    "bindings": [
      {
        "binding_type": "collection_details",
        "binding_collection_name": "$collection_name"
      },
      {
        "binding_name": "#cross_platform_enabled",
        "binding_name_override": "#enabled"
      },
      {
        "binding_type": "collection",
        "binding_name": "#is_server_info_available_collection",
        "binding_name_override": "#enabled",
        "binding_collection_name": "$collection_name"
      }
    ]
  },

  "additional_server_toggle_content": {
    "variables": [],
    "$border_texture": "textures/ui/default_indent",
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": [
          {
            "ping@play.ping_rate_panel": {
              "anchor_from": "right_middle",
              "anchor_to": "right_middle"
            }
          }
        ]
      }
    ]
  },

