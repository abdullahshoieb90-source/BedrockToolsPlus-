{
  "namespace": "safe_zone",

  "title_text": {
    "font_type": "$global_font_type"
  },

  "instructions_text": {
    "font_type": "$global_font_type"
  },

  "content_panel/safe_zone_slider_x": {
    "ignored": false
  },

  "content_panel/safe_zone_slider_y": {
    "ignored": false
  },

  "content_panel/screen_position_slider_x": {
    "ignored": false
  },

  "content_panel/screen_position_slider_y": {
    "ignored": false
  },

  "safe_zone_screen/safe_zone_bounds_markers": {
    "propagate_alpha": true,
    "anims": [
      "@common.screen_exit_animation_push_fade",
      "@common.screen_exit_animation_pop_fade",
      "@common.screen_entrance_animation_push_fade",
      "@common.screen_entrance_animation_pop_fade"
    ]
  },

  "safe_zone_screen/main_content_panel/common_panel": {
    "ignored": true
  },

  "safe_zone_screen/main_content_panel": {
    "propagate_alpha": true,
    "anims": [
      "@common.screen_exit_animation_push_fade",
      "@common.screen_exit_animation_pop_fade",
      "@common.screen_entrance_animation_push_fade",
      "@common.screen_entrance_animation_pop_fade"
    ]
  },

  "safe_zone_screen": {
    "variables": [],
    "$dialog_size": [ 192, 206 ],
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": [
          {
            "background@xc_common.background_for_pregame_only": {
              "anims": [
                "@common.screen_exit_animation_push_fade",
                "@common.screen_exit_animation_pop_fade",
                "@common.screen_entrance_animation_push_fade",
                "@common.screen_entrance_animation_pop_fade"
              ]
            }
          }
        ]
      }
    ]
  }
}