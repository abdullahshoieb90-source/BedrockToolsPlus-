{
  "namespace": "scoreboard",

  "scoreboard_sidebar_score": {
    "font_type": "$global_font_type",
    "shadow": true
  },

  "scoreboard_sidebar_player": {
    "font_type": "$global_font_type",
    "shadow": true
  },

  "scoreboard_sidebar": {
    "size": ["100%cm", "100%cm"],
    "offset": [-1, 0],
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_front",
        "value": [
          {
            "right_bar": {
              "type": "image",
              "size": [1, "100%sm"],
              "texture": "textures/ui/Xerox/White",
              "anchor_from": "right_middle",
              "anchor_to": "left_middle",
              "offset": [0, 0],
              "bindings": [
                {
                  "binding_name": "#scoreboard_sidebar_visible",
                  "binding_name_override": "#visible"
                }
              ]
            }
          }
        ]
      }
    ]
  },

  "scoreboard_sidebar/main": {
    "texture": "textures/ui/Xerox/image/BlackToTransparent3",
    "alpha": 0.6
  },

  "scoreboard_sidebar/main/displayed_objective": {
    "font_type": "$global_font_type",
    "shadow": true,
    "size": ["100%sm", 10],
    "max_size": ["100%sm", 10],
    "controls": [
    ]
  },

  "list_objective_label": {
    "font_type": "$global_font_type"
  },

  "player_rank_panel/player_rank_bg/player_rank": {
    "font_type": "$global_font_type"
  },

  "player_name": {
    "font_type": "$global_font_type"
  },

  "player_score": {
    "font_type": "$global_font_type"
  }
}