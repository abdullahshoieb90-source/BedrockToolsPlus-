                     "ignored": "(not $is_pregame)"
                  }
                },
                {
                  "background": {
                    "type": "image",
                    "size": ["100%", "100%"],
                    "texture": "textures/ui/Xerox/Black",
                    "alpha": 0.3,
                    "layer": -1999
                  }
                },
                {
                  "loading_bar": {
                    "type": "image",
                    "size": ["150px", 12],
                    "layer": -1998,
                    "texture": "textures/ui/Xerox/white_border",
                    "controls": [
                      {
                        "bars": {
                          "type": "image",
                          "size": ["100% - 4px", "100% - 4px"],
                          "alpha": "@common.loading_bars_alpha_in",
