  "container_item": {
    "$item_renderer_size|default": [14, 14],
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_front",
        "value": [
          {
            "item_button_ref_new": {
              "type": "panel",
              "layer": 5,
              "controls": [
                {
                  "default@$button_ref": { 
                    "ignored": "$touch",
                    "focus_enabled": false,
                    "tts_ignore_count": true,
                    "tts_skip_message": true,
                    "tts_inherit_siblings": true
                  }
                },
                {
                  "normal_mode": {
                    "type": "panel",
                    "ignored": "(not $touch)",
                    "bindings": [
                      {
                        "binding_type": "view",
                        "source_control_name": "xeroxclient_inv_normal",
                        "source_property_name": "#toggle_state",
                        "target_property_name": "#visible"
                      }
                    ],
                    "controls": [
                      { 
                        "button@$button_ref": {
                          "tts_ignore_count": true,
                          "tts_skip_message": true,
                          "tts_inherit_siblings": true
                        }
                      }
                    ]
                  }
                },
                {
                  "auto_place_mode": {
                    "type": "panel",
                    "ignored": "(not $touch)",
                    "bindings": [
                      {
                        "binding_type": "view",
                        "source_control_name": "xeroxclient_inv_auto_place",
                        "source_property_name": "#toggle_state",
                        "target_property_name": "#visible"
                      }
                    ],
                    "controls": [
                      { 
                        "button@$button_ref": {
                          "tts_ignore_count": true,
                          "tts_skip_message": true,
                          "tts_inherit_siblings": true,
                          "button_mappings": [
                            {
                              "from_button_id": "button.menu_select",
                              "to_button_id": "button.container_auto_place",
                              "mapping_type": "pressed"
                            },
                            {
                              "from_button_id": "button.menu_ok",
                              "to_button_id": "button.container_auto_place",
                              "mapping_type": "focused"
                            }
                          ]
                        }
                      }
                    ]
                  }
                },
                {
                  "drop_one_mode": {
                    "type": "panel",
                    "ignored": "(not $touch)",
                    "bindings": [
                      {
                        "binding_type": "view",
                        "source_control_name": "xeroxclient_inv_drop_one",
                        "source_property_name": "#toggle_state",
                        "target_property_name": "#visible"
                      }
                    ],
                    "controls": [
                      { 
                        "button@$button_ref": {
                          "tts_ignore_count": true,
                          "tts_skip_message": true,
                          "tts_inherit_siblings": true,
                          "button_mappings": [
                            {
                              "from_button_id": "button.menu_select",
                              "to_button_id": "button.drop_one",
                              "mapping_type": "pressed"
                            },
                            {
                              "from_button_id": "button.menu_ok",
                              "to_button_id": "button.drop_one",
                              "mapping_type": "focused"
                            }
                          ]
                        }
                      }
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    ]
  },

