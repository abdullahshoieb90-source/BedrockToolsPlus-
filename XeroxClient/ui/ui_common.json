  "base_screen": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_front",
        "value": [
          {
            "screen_content_text": {
              "type": "image",
              "size": ["100%cm", 10],
              "texture": "textures/ui/Xerox/White",
              "color": "$debug_green",
              "alpha": 0.65,
              "anchor_from": "top_left",
              "anchor_to": "top_left",
              "controls": [
                {
                  "text": {
                    "type": "label",
                    "size": ["default", 10],
                    "text": "$screen_content",
                    "font_type": "$global_font_type",
                    "layer": 999
                  }
                }
              ],
              "ignored": "(not $debug_mode)",
              "layer": 999,
              "visible": "(not ($screen_content = 'toast_screen.toast_screen_content' or $screen_content = 'debug_screen.content_panel'))"
            }
          }
        ]
      },
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": [
          {
            "loading_panel": {
