{
  "namespace": "common_dialogs",

  "standard_title_label": {
    "font_type": "Roboto-Bold"
  },

  "title_label": {
    "$title_size|default": ["100%", 10],
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": [
          {
            "split_line": {
              "type": "image",
              "size": ["90%", 1],
              "texture": "textures/ui/Xerox/White",
              "anchor_from": "bottom_middle",
              "anchor_to": "top_middle",
              "alpha": 0.8,
              "layer": 10,
              "offset": [0, 3]
            }
          }
        ]
      }
    ]
  },

  "main_panel_three_buttons/common_panel": {
    "$dialog_background": "dialog_image.dialog_background"
  },

  "main_panel_three_buttons/top_button_panel": {
    "size": [ "33% - 2px", 22 ],
    "offset": [ 3.5, -3 ],
    "anchor_from": "bottom_left",
    "anchor_to": "bottom_left"
  },

  "main_panel_three_buttons/middle_button_panel": {
    "size": [ "33% - 2px", 22 ],
    "offset": [ 0, -3 ]
  },

  "main_panel_three_buttons/bottom_button_panel": {
    "size": [ "33% - 2px", 22 ],
    "offset": [ -3.5, -3 ],
    "anchor_from": "bottom_right",
    "anchor_to": "bottom_right"
  },

  "main_panel_two_buttons/common_panel": {
    "$dialog_background": "dialog_image.dialog_background"
  },

  "main_panel_two_buttons/top_button_panel": {
    "size": [ "50% - 4px", 22 ],
    "offset": [ 3.5, -3 ],
    "anchor_from": "bottom_left",
    "anchor_to": "bottom_left"
  },

  "main_panel_two_buttons/bottom_button_panel": {
    "size": [ "50% - 4px", 22 ],
    "offset": [ -3.5, -3 ],
    "anchor_from": "bottom_right",
    "anchor_to": "bottom_right"
  },

  "main_panel_one_button/common_panel": {
    "$dialog_background": "dialog_image.dialog_background"
  },

  "main_panel_one_button/bottom_button_panel": {
    "size": [ "100% - 7px", 22 ],
    "offset": [ 0, -3 ]
  },

  "main_panel_no_buttons": {
    "$show_dialog_background|default": true,
    "$custom_background|default": "dialog_image.dialog_background"
  },

  "main_panel_no_buttons/common_panel": {
    "$visible": "$show_dialog_background"
  },

  "main_panel_no_title_no_buttons/common_panel": {
    "$dialog_background": "dialog_image.dialog_background"
  },

  "main_panel_small_title_one_button/common_panel": {
    "$dialog_background": "dialog_image.dialog_background"
  },

  "main_panel_small_title_one_button/bottom_button_panel": {
    "size": [ "100% - 7px", 22 ],
    "offset": [ 0, -3 ]
  },

  "main_panel": {
    "type": "panel",
    "anchor_from": "center",
    "anchor_to": "center",
    "controls": [
      { "modal_background_image@dialog_image.dialog_background": { "layer": 1 } },
      {
        "panel_indent": {
          "type": "panel",
          "size": [ "100% - 14px", "100% - 14px" ],
          "controls": [
            { "inside_header_panel@$child_control": {} }
          ]
        }
      }
    ]
  },

  "form_fitting_main_panel_no_buttons/common_panel": {
    "$dialog_background": "dialog_image.dialog_background"
  },

  "common_panel": {
    "$dialog_background|default": "dialog_image.dialog_background"
  },

  "dialog_background_opaque": { "texture": "" },
  "dialog_background_opaque_with_child": { "texture": "" },
  "dialog_background_hollow_1": { "texture": "" },
  "dialog_background_hollow_2": { "texture": "" },
  "dialog_background_hollow_3": { "texture": "" },
  "dialog_background_hollow_4": { "texture": "" },
  "dialog_background_hollow_6": { "texture": "" }
}